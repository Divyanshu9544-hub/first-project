"""
Creat a simple number guessing game.
The user gets 10 chances to game guess a number.
If the user guesses the number before 10 chance, stop asking the number from the user ,say Congrats and the gane
if the user never guesses the number, ask them 10 times and then end game!!!
"""


import random
num = 1

print("Welcomr to the number guessing game. We have a number that needs to be guessed. you have 5 attempt.")
print("====================================================================================================")
print("The secret number is between 1 and 100")
print("======================================")


secret_number = random.randint(1, 100)
attempt = 5
is_guess_correct = False

while num <= 5:
    print(f"You have {attempt} attempts remaining. ")
    print("---------------------------------------")
    user_number = (int(input("Enter your guess: ")))
    if user_number == secret_number:
        print("congrats, your guess is correct!")
        print("=================================")
        is_guess_correct = True
        break
    else:
        if user_number < secret_number:
            higher_or_lower = "higher"
        else:
            higher_or_lower = "lower"
        print(f"Your guess is Wrong! Try {higher_or_lower} number.")
        print("=====================================================")
    

    num += 1
    attempt -= 1

if is_guess_correct == False:
    print("Bad luck!! you exhausted all your attemps and couldn't guess the number. ")
    print("---------------------------------------------------------------------------")
print(f"The secret number was {secret_number}. ")
print("----------------------------------------")
print(" !!!Game Over!!!!")
print("===============")